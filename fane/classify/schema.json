{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Bills AI FixMe decisions",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "decisions"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "decisions": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "posting_id",
              "action",
              "reason"
            ],
            "properties": {
              "posting_id": {
                "type": "string",
                "minLength": 64,
                "maxLength": 64
              },
              "action": {
                "const": "defer"
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "posting_id",
              "action",
              "replacement_account",
              "confidence",
              "reason",
              "new_account",
              "rule"
            ],
            "properties": {
              "posting_id": {
                "type": "string",
                "minLength": 64,
                "maxLength": 64
              },
              "action": {
                "const": "apply"
              },
              "replacement_account": {
                "type": "string"
              },
              "confidence": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "new_account": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "comment_zh"
                    ],
                    "properties": {
                      "comment_zh": {
                        "type": "string",
                        "minLength": 1
                      },
                      "flux_label": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  }
                ]
              },
              "rule": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "provider",
                  "account_field",
                  "match"
                ],
                "properties": {
                  "provider": {
                    "enum": [
                      "alipay",
                      "wechat"
                    ]
                  },
                  "account_field": {
                    "enum": [
                      "target-account",
                      "method-account"
                    ]
                  },
                  "match": {
                    "type": "object",
                    "minProperties": 2,
                    "additionalProperties": false,
                    "properties": {
                      "peer": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 200,
                        "pattern": "^[^|,\\r\\n]+$"
                      },
                      "item": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 200,
                        "pattern": "^[^|,\\r\\n]+$"
                      },
                      "category": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 200,
                        "pattern": "^[^|,\\r\\n]+$"
                      },
                      "type": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 200,
                        "pattern": "^[^|,\\r\\n]+$"
                      },
                      "tx_type": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 200,
                        "pattern": "^[^|,\\r\\n]+$"
                      },
                      "method": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 200,
                        "pattern": "^[^|,\\r\\n]+$"
                      }
                    },
                    "anyOf": [
                      {
                        "required": [
                          "peer"
                        ]
                      },
                      {
                        "required": [
                          "item"
                        ]
                      }
                    ]
                  }
                },
                "allOf": [
                  {
                    "if": {
                      "properties": {
                        "provider": {
                          "const": "alipay"
                        }
                      }
                    },
                    "then": {
                      "properties": {
                        "match": {
                          "not": {
                            "required": [
                              "tx_type"
                            ]
                          }
                        }
                      }
                    }
                  },
                  {
                    "if": {
                      "properties": {
                        "provider": {
                          "const": "wechat"
                        }
                      }
                    },
                    "then": {
                      "properties": {
                        "match": {
                          "not": {
                            "required": [
                              "type"
                            ]
                          }
                        }
                      }
                    }
                  }
                ]
              }
            }
          }
        ]
      }
    }
  }
}
